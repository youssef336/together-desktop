{
  "name": "together-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A little world for the two of you — a pixel couple living on your desktop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build",
    "sheet": "tsx tools/sprite-sheet.ts",
    "icons": "tsx tools/icons.ts && tauri icon src-tauri/icons/source.png",
    "scenes": "tsx tools/scene-sheet.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-sql": "2.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
